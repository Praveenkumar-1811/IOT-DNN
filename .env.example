# Copy the frontend setting to frontend/.env.local for local Next.js development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend settings are read from the process environment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=backend/energy.db
MODEL_DIR=backend
TRAINING_DATA=backend/data/demo_energy_data.csv
THRESHOLD_PERCENTILE=95